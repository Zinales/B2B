  "wb_payroll_profiles": {
   "title": "Payroll profiles",
   "description": "One per person paid. Salary, hourly rate, tax number and bank account are encrypted (wb_enc).",
   "fields": [
    {
     "name": "staff_id",
     "type": "number"
    },
    {
     "name": "pay_type",
     "type": "select",
     "options": [
      "monthly",
      "hourly"
     ]
    },
    {
     "name": "salary_enc",
     "type": "text"
    },
    {
     "name": "hourly_rate_enc",
     "type": "text"
    },
    {
     "name": "tax_number_enc",
     "type": "text"
    },
    {
     "name": "bank_account_enc",
     "type": "text"
    },
    {
     "name": "bank_branch_code",
     "type": "text"
    },
    {
     "name": "date_of_birth",
     "type": "date",
     "note": "for the age rebates (65, 75) on the last day of the tax year"
    },
    {
     "name": "medical_scheme_members",
     "type": "number",
     "note": "0 none · 1 member only · 2 member + 1 · …"
    },
    {
     "name": "retirement_contribution_pct",
     "type": "number"
    },
    {
     "name": "retirement_contribution_fixed",
     "type": "number"
    },
    {
     "name": "uif_exempt",
     "type": "select",
     "options": [
      "no",
      "yes"
     ]
    },
    {
     "name": "start_date",
     "type": "date"
    },
    {
     "name": "end_date",
     "type": "date"
    },
    {
     "name": "record_status",
     "type": "select",
     "options": [
      "active",
      "archived",
      "inactive",
      "void"
     ],
     "default": "active"
    }
   ]
  },
  "wb_pay_runs": {
   "title": "Pay runs",
   "description": "One per month: draft → checked (by a different person) → finalised. A finalised run is never changed (WB_CCT refuses).",
   "fields": [
    {
     "name": "period",
     "type": "text",
     "note": "YYYY-MM"
    },
    {
     "name": "period_start",
     "type": "date"
    },
    {
     "name": "period_end",
     "type": "date"
    },
    {
     "name": "pay_date",
     "type": "date"
    },
    {
     "name": "tax_year",
     "type": "text"
    },
    {
     "name": "status",
     "type": "select",
     "options": [
      "draft",
      "checked",
      "finalised"
     ]
    },
    {
     "name": "prepared_by",
     "type": "number",
     "note": "wb_staff id"
    },
    {
     "name": "checked_by",
     "type": "number",
     "note": "wb_staff id; never the preparer"
    },
    {
     "name": "checked_at",
     "type": "datetime-local"
    },
    {
     "name": "finalised_at",
     "type": "datetime-local"
    },
    {
     "name": "finalised_by",
     "type": "number"
    },
    {
     "name": "headcount",
     "type": "number"
    },
    {
     "name": "gross_total",
     "type": "number"
    },
    {
     "name": "paye_total",
     "type": "number"
    },
    {
     "name": "uif_employee_total",
     "type": "number"
    },
    {
     "name": "uif_employer_total",
     "type": "number"
    },
    {
     "name": "sdl_total",
     "type": "number"
    },
    {
     "name": "other_deductions_total",
     "type": "number"
    },
    {
     "name": "net_total",
     "type": "number"
    },
    {
     "name": "notes",
     "type": "text"
    },
    {
     "name": "editors_json",
     "type": "textarea",
     "extension": true,
     "description": "0.2.1: JSON list of staff ids who changed the draft run (recalculated or adjusted). Nobody on this list, nor the preparer, may check the run."
    },
    {
     "name": "record_status",
     "type": "select",
     "options": [
      "active",
      "archived",
      "inactive",
      "void"
     ],
     "default": "active"
    }
   ]
  },
  "wb_payslips": {
   "title": "Payslips",
   "description": "One per person per run. Immutable once finalised; a correction is an adjustment in the next run. pdf_key = the stored payslip page (HTML in 0.2.0).",
   "fields": [
    {
     "name": "run_id",
     "type": "number"
    },
    {
     "name": "staff_id",
     "type": "number"
    },
    {
     "name": "period",
     "type": "text"
    },
    {
     "name": "status",
     "type": "select",
     "options": [
      "draft",
      "finalised"
     ]
    },
    {
     "name": "lines_json",
     "type": "textarea",
     "note": "inputs, adjustments, earning/deduction/employer lines with their purpose, warnings, tax year"
    },
    {
     "name": "gross",
     "type": "number"
    },
    {
     "name": "taxable",
     "type": "number"
    },
    {
     "name": "paye",
     "type": "number"
    },
    {
     "name": "uif_employee",
     "type": "number"
    },
    {
     "name": "uif_employer",
     "type": "number"
    },
    {
     "name": "sdl",
     "type": "number"
    },
    {
     "name": "other_deductions",
     "type": "number",
     "note": "retirement contribution + other deductions"
    },
    {
     "name": "net",
     "type": "number"
    },
    {
     "name": "ordinary_hours",
     "type": "number"
    },
    {
     "name": "overtime_hours",
     "type": "number"
    },
    {
     "name": "pdf_key",
     "type": "text"
    },
    {
     "name": "record_status",
     "type": "select",
     "options": [
      "active",
      "archived",
      "inactive",
      "void"
     ],
     "default": "active"
    }
   ]
  }
 }
}